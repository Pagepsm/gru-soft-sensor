    "def resolve_result_root(cfg):\n",
    "    if cfg.use_google_drive:\n",
    "        try:\n",
    "            from google.colab import drive\n",
    "        except ModuleNotFoundError as exc:\n",
    "            raise RuntimeError(\n",
    "                \"use_google_drive=TrueだがGoogle Colabではない\"\n",
    "            ) from exc\n",
    "        drive.mount(\"/content/drive\")\n",
    "        parent = Path(cfg.google_drive_parent)\n",
    "    else:\n",
    "        parent = Path.cwd()\n",
    "    root = parent / cfg.result_folder_name\n",
    "    root.mkdir(parents=True, exist_ok=True)\n",
    "    return root\n",
    "\n",
    "\n",
    "RESULT_ROOT = resolve_result_root(CFG)\n",
    "RUN_STAGE = CFG.run_stage\n",
    "STAGE_DIR = RESULT_ROOT / RUN_STAGE\n",
    "STAGE_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "RUNNING = STAGE_DIR / \"RUNNING\"\n",
    "COMPLETE = STAGE_DIR / \"COMPLETE\"\n",
    "FAILED = STAGE_DIR / \"FAILED\"\n",
    "ERRORS_PATH = STAGE_DIR / \"errors.jsonl\"\n",
    "RUN_STARTED_AT = time.strftime(\"%Y-%m-%dT%H:%M:%S\")\n",
    "\n",
    "for marker in (COMPLETE, FAILED):\n",
    "    if marker.exists():\n",
    "        marker.unlink()\n",
    "RUNNING.write_text(RUN_STARTED_AT, encoding=\"utf-8\")\n",
    "\n",
    "TIMING_ROWS = []\n",
    "ERROR_ROWS = []\n",
    "RESULT_TABLES = {}\n",
    "\n",
    "\n",
    "def _jsonable(value):\n",
    "    if isinstance(value, (np.integer,)):\n",
    "        return int(value)\n",
    "    if isinstance(value, (np.floating,)):\n",
    "        return float(value)\n",
    "    if isinstance(value, np.ndarray):\n",
    "        return value.tolist()\n",
    "    if isinstance(value, Path):\n",
    "        return str(value)\n",
    "    raise TypeError(f\"not JSON serializable: {type(value)}\")\n",
    "\n",
    "\n",
    "def atomic_replace(tmp, path):\n",
    "    tmp.replace(path)\n",
    "\n",
    "\n",
    "def save_json(name, obj):\n",
    "    path = STAGE_DIR / name\n",
    "    tmp = STAGE_DIR / f\"{name}.tmp\"\n",
    "    with tmp.open(\"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(\n",
    "            obj,\n",
    "            f,\n",
    "            ensure_ascii=False,\n",
    "            indent=2,\n",
    "            default=_jsonable,\n",
    "            allow_nan=False,\n",
    "        )\n",
    "    atomic_replace(tmp, path)\n",
    "    return path\n",
    "\n",
    "\n",
    "def save_table(name, frame):\n",
    "    frame = frame.copy()\n",
    "    csv_path = STAGE_DIR / f\"{name}.csv\"\n",
    "    json_path = STAGE_DIR / f\"{name}.json\"\n",
    "    csv_tmp = STAGE_DIR / f\"{name}.csv.tmp\"\n",
    "    json_tmp = STAGE_DIR / f\"{name}.json.tmp\"\n",
    "    frame.to_csv(csv_tmp, index=False, encoding=\"utf-8-sig\")\n",
    "    records = frame.replace({np.nan: None}).to_dict(orient=\"records\")\n",
    "    with json_tmp.open(\"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(records, f, ensure_ascii=False, indent=2, default=_jsonable, allow_nan=False)\n",
    "    atomic_replace(csv_tmp, csv_path)\n",
    "    atomic_replace(json_tmp, json_path)\n",
    "    RESULT_TABLES[name] = frame\n",
    "    print(\"saved:\", csv_path.resolve())\n",
    "    return csv_path\n",
    "\n",
    "\n",
    "def save_figure(name):\n",
    "    path = STAGE_DIR / f\"{name}.png\"\n",
    "    tmp = STAGE_DIR / f\"{name}.tmp.png\"\n",
    "    plt.savefig(tmp, dpi=180, bbox_inches=\"tight\")\n",
    "    atomic_replace(tmp, path)\n",
    "    return path\n",
    "\n",
    "\n",
    "def record_timing(name, elapsed, status=\"ok\"):\n",
    "    TIMING_ROWS.append({\n",
    "        \"stage\": RUN_STAGE,\n",
    "        \"test\": name,\n",
    "        \"elapsed_sec\": float(elapsed),\n",
    "        \"status\": status,\n",
    "        \"finished_at\": time.strftime(\"%Y-%m-%dT%H:%M:%S\"),\n",
    "    })\n",
    "    tmp = STAGE_DIR / \"timing.csv.tmp\"\n",
    "    path = STAGE_DIR / \"timing.csv\"\n",
    "    pd.DataFrame(TIMING_ROWS).to_csv(tmp, index=False, encoding=\"utf-8-sig\")\n",
    "    atomic_replace(tmp, path)\n",
    "\n",
    "\n",
    "def record_error(name, exc):\n",
    "    row = {\n",
    "        \"stage\": RUN_STAGE,\n",
    "        \"test\": name,\n",
    "        \"error_type\": type(exc).__name__,\n",
    "        \"message\": str(exc),\n",
    "        \"traceback\": traceback.format_exc(),\n",
    "        \"time\": time.strftime(\"%Y-%m-%dT%H:%M:%S\"),\n",
    "    }\n",
    "    ERROR_ROWS.append(row)\n",
    "    with ERRORS_PATH.open(\"a\", encoding=\"utf-8\") as f:\n",
    "        f.write(json.dumps(row, ensure_ascii=False) + \"\\n\")\n",
    "    FAILED.write_text(row[\"time\"], encoding=\"utf-8\")\n",
    "\n",
    "\n",
    "def progress(iterable, desc, total=None, leave=False, unit=\"it\"):\n",
    "    return tqdm(\n",
    "        iterable,\n",
    "        desc=desc,\n",
    "        total=total,\n",
    "        leave=leave,\n",
    "        unit=unit,\n",
    "        dynamic_ncols=True,\n",
    "        mininterval=0.5,\n",
    "        disable=not CFG.show_progress,\n",
    "    )\n",
    "\n",
    "\n",
    "def stage_enabled(name):\n",
    "    if RUN_STAGE == \"smoke\":\n",
    "        return True\n",
    "    return RUN_STAGE in {name, \"all\"}\n",
    "\n",
    "\n",
    "save_json(\"config.json\", {\n",
    "    \"config\": asdict(CFG),\n",
    "    \"device\": str(DEVICE),\n",
    "    \"python_version\": sys.version,\n",
    "    \"torch_version\": torch.__version__,\n",
    "    \"cuda_available\": torch.cuda.is_available(),\n",
    "    \"cudnn_enabled\": torch.backends.cudnn.enabled,\n",
    "    \"cudnn_version\": torch.backends.cudnn.version() if torch.cuda.is_available() else None,\n",
    "    \"platform\": platform.platform(),\n",
    "    \"run_started_at\": RUN_STARTED_AT,\n",
    "})\n",
    "\n",
    "print(\"RESULT_ROOT:\", RESULT_ROOT.resolve())\n",
    "print(\"STAGE_DIR:\", STAGE_DIR.resolve())\n"
   ]
  },
