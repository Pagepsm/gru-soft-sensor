    "class LinearResyncGain(nn.Module):\n",
    "    def __init__(self, cfg):\n",
    "        super().__init__()\n",
    "        self.k = nn.Parameter(torch.zeros(cfg.slow_dim))\n",
    "        self.cap = float(cfg.correction_cap)\n",
    "        self.slow_dim = int(cfg.slow_dim)\n",
    "\n",
    "    def forward(self, z, residual_scaled, delay_scaled, confidence):\n",
    "        raw = residual_scaled[:, None] * self.k[None, :]\n",
    "        delta_slow = self.cap * torch.tanh(raw / self.cap)\n",
    "        delta_slow = delta_slow * confidence[:, None]\n",
    "        delta = torch.zeros_like(z)\n",
    "        delta[:, -self.slow_dim:] = delta_slow\n",
    "        return delta\n",
    "\n",
    "\n",
    "class NonlinearResyncGain(nn.Module):\n",
    "    def __init__(self, cfg):\n",
    "        super().__init__()\n",
    "        self.cap = float(cfg.correction_cap)\n",
    "        self.slow_dim = int(cfg.slow_dim)\n",
    "        input_dim = cfg.slow_dim + 3\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(input_dim, 24),\n",
    "            nn.GELU(),\n",
    "            nn.Linear(24, 24),\n",
    "            nn.GELU(),\n",
    "            nn.Linear(24, cfg.slow_dim),\n",
    "        )\n",
    "\n",
    "    def forward(self, z, residual_scaled, delay_scaled, confidence):\n",
    "        inp = torch.cat([\n",
    "            z[:, -self.slow_dim:],\n",
    "            residual_scaled[:, None],\n",
    "            delay_scaled[:, None],\n",
    "            confidence[:, None],\n",
    "        ], dim=1)\n",
    "        delta_slow = self.cap * torch.tanh(self.net(inp) / self.cap)\n",
    "        delta_slow = delta_slow * confidence[:, None]\n",
    "        delta = torch.zeros_like(z)\n",
    "        delta[:, -self.slow_dim:] = delta_slow\n",
    "        return delta\n",
    "\n",
    "\n",
    "class GainEventDataset(Dataset):\n",
    "    def __init__(self, Z, data, split_name, cfg):\n",
    "        mask = data[f\"q_{split_name}_mask\"]\n",
    "        selected = np.where(mask)[0]\n",
    "        examples = []\n",
    "        for j in selected:\n",
    "            if j + 1 >= len(data[\"feature_times\"]):\n",
    "                continue\n",
    "            if not mask[j + 1]:\n",
    "                continue\n",
    "            tau = int(data[\"feature_times\"][j])\n",
    "            next_tau = int(data[\"feature_times\"][j + 1])\n",
    "            if next_tau <= tau or not np.isfinite(Z[tau]).all():\n",
    "                continue\n",
    "            examples.append((j, j + 1, tau, next_tau))\n",
    "        self.examples = examples\n",
    "        self.Z = torch.from_numpy(Z.astype(np.float32))\n",
    "        self.X = torch.from_numpy(data[\"X\"])\n",
    "        self.U = torch.from_numpy(data[\"U\"])\n",
    "        self.M = torch.from_numpy(data[\"mask\"])\n",
    "        self.y = torch.from_numpy(data[\"q_obs_scaled\"].astype(np.float32))\n",
    "        self.conf = torch.from_numpy(data[\"q_confidence\"].astype(np.float32))\n",
    "        self.delay_scaled = float(data[\"delay\"] / max(1, cfg.quality_interval))\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.examples)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        j, jn, tau, next_tau = self.examples[idx]\n",
    "        return (\n",
    "            self.Z[tau],\n",
    "            self.U[tau + 1:next_tau + 1],\n",
    "            self.X[tau + 1:next_tau + 1],\n",
    "            self.M[tau + 1:next_tau + 1],\n",
    "            self.y[j],\n",
    "            self.y[jn],\n",
    "            self.conf[j],\n",
    "            torch.tensor(self.delay_scaled, dtype=torch.float32),\n",
    "        )\n",
    "\n",
    "\n",
    "def freeze_module(model):\n",
    "    model.eval()\n",
    "    for p in model.parameters():\n",
    "        p.requires_grad_(False)\n",
    "\n",
    "\n",
    "def evaluate_gain_loss(gain, loader, dt_model, q_head, cfg):\n",
    "    gain.eval()\n",
    "    values = []\n",
    "    with torch.no_grad():\n",
    "        for batch in loader:\n",
    "            z, up, xs, ms, y0, y1, conf, delay_scaled = [v.to(DEVICE) for v in batch]\n",
    "            pred0 = q_head(z)\n",
    "            residual = torch.clamp(y0 - pred0, -cfg.innovation_clip, cfg.innovation_clip)\n",
    "            delta = gain(z, residual, delay_scaled, conf)\n",
    "            zc = z + delta\n",
    "            z1 = replay_batch(dt_model, zc, up, xs, ms)\n",
    "            loss0 = nn.functional.smooth_l1_loss(q_head(zc), y0)\n",
    "            loss1 = nn.functional.smooth_l1_loss(q_head(z1), y1)\n",
    "            reg = (delta ** 2).mean()\n",
    "            loss = cfg.gain_current_weight * loss0 + cfg.gain_future_weight * loss1 + cfg.gain_regularization * reg\n",
    "            values.append(float(loss.item()))\n",
    "            if CFG.run_stage == \"smoke\":\n",
    "                break\n",
    "    return float(np.mean(values)) if values else float(\"inf\")\n",
    "\n",
    "\n",
    "def train_gain(gain, Z, data, dt_model, q_head, cfg, seed, name):\n",
    "    train_ds = GainEventDataset(Z, data, \"train\", cfg)\n",
    "    val_ds = GainEventDataset(Z, data, \"val\", cfg)\n",
    "    if len(train_ds) == 0 or len(val_ds) == 0:\n",
    "        raise ValueError(\"empty gain dataset\")\n",
    "\n",
    "    generator = torch.Generator().manual_seed(seed + 200_000)\n",
    "    train_loader = DataLoader(\n",
    "        train_ds,\n",
    "        batch_size=min(cfg.gain_batch_size, len(train_ds)),\n",
    "        shuffle=True,\n",
    "        generator=generator,\n",
    "    )\n",
    "    val_loader = DataLoader(\n",
    "        val_ds,\n",
    "        batch_size=min(cfg.gain_batch_size, len(val_ds)),\n",
    "        shuffle=False,\n",
    "    )\n",
    "\n",
    "    freeze_module(dt_model)\n",
    "    freeze_module(q_head)\n",
    "    gain = gain.to(DEVICE)\n",
    "    optimizer = torch.optim.Adam(gain.parameters(), lr=cfg.gain_lr)\n",
    "    best_val = float(\"inf\")\n",
    "    best_state = copy.deepcopy(gain.state_dict())\n",
    "    best_epoch = 0\n",
    "    wait = 0\n",
    "    history = []\n",
    "\n",
    "    epoch_bar = progress(\n",
    "        range(1, cfg.gain_epochs + 1),\n",
    "        desc=f\"{name} | seed={seed}\",\n",
    "        total=cfg.gain_epochs,\n",
    "        leave=False,\n",
    "        unit=\"epoch\",\n",
    "    )\n",
    "    for epoch in epoch_bar:\n",
    "        gain.train()\n",
    "        train_values = []\n",
    "        for batch in train_loader:\n",
    "            z, up, xs, ms, y0, y1, conf, delay_scaled = [v.to(DEVICE) for v in batch]\n",
    "            with torch.no_grad():\n",
    "                pred0 = q_head(z)\n",
    "            residual = torch.clamp(y0 - pred0, -cfg.innovation_clip, cfg.innovation_clip)\n",
    "            optimizer.zero_grad(set_to_none=True)\n",
    "            delta = gain(z, residual, delay_scaled, conf)\n",
    "            zc = z + delta\n",
    "            z1 = replay_batch(dt_model, zc, up, xs, ms)\n",
    "            loss0 = nn.functional.smooth_l1_loss(q_head(zc), y0)\n",
    "            loss1 = nn.functional.smooth_l1_loss(q_head(z1), y1)\n",
    "            reg = (delta ** 2).mean()\n",
    "            loss = cfg.gain_current_weight * loss0 + cfg.gain_future_weight * loss1 + cfg.gain_regularization * reg\n",
    "            loss.backward()\n",
    "            torch.nn.utils.clip_grad_norm_(gain.parameters(), 1.0)\n",
    "            optimizer.step()\n",
    "            train_values.append(float(loss.item()))\n",
    "            if CFG.run_stage == \"smoke\":\n",
    "                break\n",
    "\n",
    "        val = evaluate_gain_loss(gain, val_loader, dt_model, q_head, cfg)\n",
    "        history.append({\"epoch\": epoch, \"train_loss\": float(np.mean(train_values)), \"val_loss\": val})\n",
    "        if val < best_val - 1.0e-5:\n",
    "            best_val = val\n",
    "            best_state = copy.deepcopy(gain.state_dict())\n",
    "            best_epoch = epoch\n",
    "            wait = 0\n",
    "        else:\n",
    "            wait += 1\n",
    "        epoch_bar.set_postfix(val=f\"{val:.4f}\", best=f\"{best_val:.4f}\")\n",
    "        if wait >= cfg.gain_patience:\n",
    "            break\n",
    "    epoch_bar.close()\n",
    "    gain.load_state_dict(best_state)\n",
    "    gain.eval()\n",
    "    return gain, pd.DataFrame(history), best_val, best_epoch\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e427d346",
   "metadata": {},
   "source": [
    "## 13. 比較方法\n",
    "\n",
    "いくつかの補正方法で、品質が届いた後の誤差を比べる。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7ef23980",
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_resync_methods(\n",
    "    data,\n",
    "    dt_model,\n",
    "    q_head,\n",
    "    Z,\n",
    "    cfg,\n",
    "    seed,\n",
    "    gain=None,\n",
    "    gain_name=None,\n",
    "    include_oracle=True,\n",
    "):\n",
    "    rows = []\n",
    "    test_indices = np.where(data[\"q_test_mask\"])[0]\n",
    "    event_iter = progress(\n",
    "        test_indices,\n",
    "        desc=f\"resync eval | seed={seed} | {data['disturbance_shape']}\",\n",
    "        total=len(test_indices),\n",
    "        leave=False,\n",
    "        unit=\"event\",\n",
    "    )\n",
    "\n",
    "    for event_count, j in enumerate(event_iter):\n",
    "        tau = int(data[\"feature_times\"][j])\n",
    "        arrival = int(data[\"arrival_times\"][j])\n",
    "        if arrival >= len(data[\"X\"]) - 2 or not np.isfinite(Z[tau]).all():\n",
    "            continue\n",
    "\n",
    "        next_candidates = data[\"feature_times\"][data[\"feature_times\"] > arrival]\n",
    "        next_tau = int(next_candidates[0]) if len(next_candidates) else None\n",
    "        max_dense = min(max(cfg.dense_horizons), len(data[\"X\"]) - arrival - 1)\n",
    "        if max_dense <= 0:\n",
    "            continue\n",
    "        dense_times = list(range(arrival + 1, arrival + max_dense + 1))\n",
    "        target_times = dense_times.copy()\n",
    "        if next_tau is not None and next_tau < len(data[\"X\"]):\n",
    "            target_times.append(next_tau)\n",
    "\n",
    "        z_tau = torch.from_numpy(Z[tau:tau + 1]).to(DEVICE)\n",
    "        q_tau_pred = float(predict_quality_np(q_head, z_tau, data)[0])\n",
    "        residual = float(data[\"q_obs\"][j] - q_tau_pred)\n",
    "        residual_scaled_value = float(residual / float(data[\"q_std\"]))\n",
    "        residual_scaled_value = float(np.clip(residual_scaled_value, -cfg.innovation_clip, cfg.innovation_clip))\n",
    "        residual_scaled = torch.tensor([residual_scaled_value], dtype=torch.float32, device=DEVICE)\n",
    "        confidence = torch.tensor([float(data[\"q_confidence\"][j])], dtype=torch.float32, device=DEVICE)\n",
    "        delay_scaled = torch.tensor([float(data[\"delay\"] / max(1, data[\"quality_interval\"]))], dtype=torch.float32, device=DEVICE)\n",
    "\n",
    "        method_predictions = {}\n",
    "        correction_norms = {}\n",
    "\n",
    "        # 補正なし。\n",
    "        base_z = torch.from_numpy(Z[target_times]).to(DEVICE)\n",
    "        base_pred = predict_quality_np(q_head, base_z, data)\n",
    "        method_predictions[\"no_resync\"] = dict(zip(target_times, base_pred.tolist()))\n",
    "        correction_norms[\"no_resync\"] = 0.0\n",
    "\n",
    "        # 出力バイアス。\n",
    "        persistent = {}\n",
    "        decayed = {}\n",
    "        for t, p in method_predictions[\"no_resync\"].items():\n",
    "            elapsed = max(0, t - arrival)\n",
    "            persistent[t] = p + residual\n",
    "            decayed[t] = p + residual * math.exp(-elapsed / max(1.0, cfg.bias_decay_steps))\n",
    "        method_predictions[\"output_bias_persistent\"] = persistent\n",
    "        method_predictions[\"output_bias_decay\"] = decayed\n",
    "        correction_norms[\"output_bias_persistent\"] = abs(residual_scaled_value)\n",
    "        correction_norms[\"output_bias_decay\"] = abs(residual_scaled_value)\n",
    "\n",
    "        # 最新履歴から状態を作り直す。\n",
    "        z_current = reencode_at(dt_model, data, cfg, arrival)\n",
    "        states, _ = propagate_single(dt_model, data, z_current, arrival, target_times)\n",
    "        method_predictions[\"current_reencode\"] = {\n",
    "            t: float(predict_quality_np(q_head, states[t], data)[0]) for t in target_times\n",
    "        }\n",
    "        correction_norms[\"current_reencode\"] = float(torch.linalg.vector_norm(z_current - torch.from_numpy(Z[arrival:arrival + 1]).to(DEVICE)).item()) if np.isfinite(Z[arrival]).all() else float(\"nan\")\n",
    "\n",
    "        # 品質ヘッドのみをオンライン更新する。\n",
    "        local_head = online_update_head(q_head, z_tau, float(data[\"q_obs_scaled\"][j]), cfg)\n",
    "        local_pred = predict_quality_np(local_head, base_z, data)\n",
    "        method_predictions[\"online_head_update\"] = dict(zip(target_times, local_pred.tolist()))\n",
    "        correction_norms[\"online_head_update\"] = 0.0\n",
    "\n",
    "        corrections = {}\n",
    "        corrections[\"past_state_jacobian\"] = jacobian_correction(q_head, z_tau, residual_scaled, cfg)\n",
    "        if gain is not None:\n",
    "            corrections[gain_name] = gain(z_tau, residual_scaled, delay_scaled, confidence).detach()\n",
    "        if include_oracle and event_count < cfg.oracle_max_events:\n",
    "            corrections[\"oracle_resync\"] = oracle_correction(\n",
    "                dt_model,\n",
    "                q_head,\n",
    "                data,\n",
    "                z_tau,\n",
    "                tau,\n",
    "                arrival,\n",
    "                cfg,\n",
    "            ).detach()\n",
    "\n",
    "        for method, delta in corrections.items():\n",
    "            z_corrected = z_tau + delta\n",
    "            state_map, z_arrival = propagate_single(dt_model, data, z_corrected, tau, [arrival])\n",
    "            z_a = state_map[arrival]\n",
    "            future_map, _ = propagate_single(dt_model, data, z_a, arrival, target_times)\n",
    "            method_predictions[method] = {\n",
    "                t: float(predict_quality_np(q_head, future_map[t], data)[0]) for t in target_times\n",
    "            }\n",
    "            correction_norms[method] = float(torch.linalg.vector_norm(delta).item())\n",
    "\n",
    "        for method, pred_map in method_predictions.items():\n",
    "            row = {\n",
    "                \"seed\": seed,\n",
    "                \"disturbance_shape\": data[\"disturbance_shape\"],\n",
    "                \"disturbance_strength\": data[\"disturbance_strength\"],\n",
    "                \"method\": method,\n",
    "                \"event_index\": int(j),\n",
    "                \"tau\": tau,\n",
    "                \"arrival\": arrival,\n",
    "                \"delay\": int(data[\"delay\"]),\n",
    "                \"quality_interval\": int(data[\"quality_interval\"]),\n",
    "                \"residual_observed\": residual,\n",
    "                \"residual_scaled\": residual_scaled_value,\n",
    "                \"confidence\": float(data[\"q_confidence\"][j]),\n",
    "                \"correction_norm\": correction_norms.get(method, 0.0),\n",
    "                \"future_lab_obs_abs_error\": float(\"nan\"),\n",
    "                \"future_lab_true_abs_error_diagnostic\": float(\"nan\"),\n",
    "            }\n",
    "            if next_tau is not None and next_tau in pred_map:\n",
    "                next_label_positions = np.where(data[\"feature_times\"] == next_tau)[0]\n",
    "                if len(next_label_positions):\n",
    "                    jn = int(next_label_positions[0])\n",
    "                    row[\"future_lab_obs_abs_error\"] = abs(float(data[\"q_obs\"][jn]) - pred_map[next_tau])\n",
    "                    row[\"future_lab_true_abs_error_diagnostic\"] = abs(float(data[\"q_true\"][next_tau]) - pred_map[next_tau])\n",
    "            for h in cfg.dense_horizons:\n",
    "                h_eff = min(int(h), max_dense)\n",
    "                times_h = list(range(arrival + 1, arrival + h_eff + 1))\n",
    "                pred_h = np.array([pred_map[t] for t in times_h], dtype=np.float32)\n",
    "                true_h = data[\"q_true\"][times_h]\n",
    "                row[f\"dense_true_mae_h{h}\"] = safe_mae(true_h, pred_h)\n",
    "            rows.append(row)\n",
    "\n",
    "        if CFG.run_stage == \"smoke\" and event_count >= 0:\n",
    "            break\n",
    "\n",
    "    event_iter.close()\n",
    "    return pd.DataFrame(rows)\n"
   ]
  },
