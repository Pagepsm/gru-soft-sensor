    "## 22. 結果を保存\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b6c41967",
   "metadata": {},
   "outputs": [],
   "source": [
    "SUMMARY = {\n",
    "    \"stage\": RUN_STAGE,\n",
    "    \"run_started_at\": RUN_STARTED_AT,\n",
    "    \"run_finished_at\": time.strftime(\"%Y-%m-%dT%H:%M:%S\"),\n",
    "    \"config\": asdict(CFG),\n",
    "    \"practicality_audit\": PRACTICALITY_AUDIT,\n",
    "    \"completed_tables\": {\n",
    "        name: int(len(frame))\n",
    "        for name, frame in RESULT_TABLES.items()\n",
    "        if isinstance(frame, pd.DataFrame) and not frame.empty\n",
    "    },\n",
    "    \"timing\": TIMING_ROWS,\n",
    "    \"errors\": ERROR_ROWS,\n",
    "}\n",
    "save_json(\"summary.json\", SUMMARY)\n",
    "\n",
    "history_path = RESULT_ROOT / f\"run_history_{RUN_STAGE}.csv\"\n",
    "history_tmp = RESULT_ROOT / f\"run_history_{RUN_STAGE}.csv.tmp\"\n",
    "history_row = pd.DataFrame([{\n",
    "    \"stage\": RUN_STAGE,\n",
    "    \"started_at\": RUN_STARTED_AT,\n",
    "    \"finished_at\": SUMMARY[\"run_finished_at\"],\n",
    "    \"status\": \"error\" if ERROR_ROWS else \"ok\",\n",
    "    \"completed_tables\": \",\".join(SUMMARY[\"completed_tables\"].keys()),\n",
    "    \"device\": str(DEVICE),\n",
    "}])\n",
    "history_row.to_csv(history_tmp, index=False, encoding=\"utf-8-sig\")\n",
    "atomic_replace(history_tmp, history_path)\n",
    "\n",
    "if ERROR_ROWS:\n",
    "    FAILED.write_text(SUMMARY[\"run_finished_at\"], encoding=\"utf-8\")\n",
    "else:\n",
    "    COMPLETE.write_text(SUMMARY[\"run_finished_at\"], encoding=\"utf-8\")\n",
    "    if FAILED.exists():\n",
    "        FAILED.unlink()\n",
    "if RUNNING.exists():\n",
    "    RUNNING.unlink()\n",
    "\n",
    "print(\"stage directory:\", STAGE_DIR.resolve())\n",
    "print(\"completed tables:\", SUMMARY[\"completed_tables\"])\n",
    "print(\"status:\", \"FAILED\" if ERROR_ROWS else \"COMPLETE\")\n"
   ]
