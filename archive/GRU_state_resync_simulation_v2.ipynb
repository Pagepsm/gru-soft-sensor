    "## 5. 共通関数\n",
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dca5b172",
   "metadata": {},
   "outputs": [],
   "source": [
    "def set_seed(seed):\n",
    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    torch.manual_seed(seed)\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.manual_seed_all(seed)\n",
    "        torch.backends.cudnn.deterministic = True\n",
    "        torch.backends.cudnn.benchmark = False\n",
    "\n",
    "\n",
    "def split_bounds(T, train_ratio, val_ratio):\n",
    "    train_end = int(T * train_ratio)\n",
    "    val_end = int(T * (train_ratio + val_ratio))\n",
    "    if not (0 < train_end < val_end < T):\n",
    "        raise ValueError(\"invalid train/validation/test split\")\n",
    "    return train_end, val_end\n",
    "\n",
    "\n",
    "def forward_fill_observed(X_obs, train_end):\n",
    "    X_obs = np.asarray(X_obs, dtype=np.float32)\n",
    "    X_fill = X_obs.copy()\n",
    "    train_mean = np.nanmean(X_fill[:train_end], axis=0)\n",
    "    if not np.isfinite(train_mean).all():\n",
    "        raise ValueError(\"a sensor has no observed training value\")\n",
    "    for j in range(X_fill.shape[1]):\n",
    "        last = float(train_mean[j])\n",
    "        for t in range(len(X_fill)):\n",
    "            if np.isfinite(X_fill[t, j]):\n",
    "                last = float(X_fill[t, j])\n",
    "            else:\n",
    "                X_fill[t, j] = last\n",
    "    return X_fill, train_mean.astype(np.float32)\n",
    "\n",
    "\n",
    "def standardize_from_train(A, train_end, eps=1.0e-6):\n",
    "    mean = A[:train_end].mean(axis=0, keepdims=True)\n",
    "    std = A[:train_end].std(axis=0, keepdims=True)\n",
    "    std = np.maximum(std, eps)\n",
    "    return (\n",
    "        ((A - mean) / std).astype(np.float32),\n",
    "        mean.astype(np.float32),\n",
    "        std.astype(np.float32),\n",
    "    )\n",
    "\n",
    "\n",
    "def apply_standardization(A, mean, std):\n",
    "    return ((A - mean) / std).astype(np.float32)\n",
    "\n",
    "\n",
    "def unscale_quality(y_scaled, data):\n",
    "    return np.asarray(y_scaled) * float(data[\"q_std\"]) + float(data[\"q_mean\"])\n",
    "\n",
    "\n",
    "def safe_mae(y, p):\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    p = np.asarray(p, dtype=float)\n",
    "    if len(y) == 0:\n",
    "        return float(\"nan\")\n",
    "    return float(np.mean(np.abs(y - p)))\n",
    "\n",
    "\n",
    "def summarize_table(frame, group_cols, value_cols):\n",
    "    if frame.empty:\n",
    "        return pd.DataFrame()\n",
    "    pieces = []\n",
    "    grouped = frame.groupby(group_cols, dropna=False)\n",
    "    for name, group in grouped:\n",
    "        if not isinstance(name, tuple):\n",
    "            name = (name,)\n",
    "        row = dict(zip(group_cols, name))\n",
    "        row[\"count\"] = int(len(group))\n",
    "        for col in value_cols:\n",
    "            values = pd.to_numeric(group[col], errors=\"coerce\")\n",
    "            row[f\"{col}_mean\"] = float(values.mean())\n",
    "            row[f\"{col}_std\"] = float(values.std(ddof=1)) if len(values) > 1 else 0.0\n",
    "        pieces.append(row)\n",
    "    return pd.DataFrame(pieces)\n",
    "\n",
    "\n",
    "def parameter_count(model):\n",
    "    return int(sum(p.numel() for p in model.parameters()))\n"
   ]
  },
