   "source": [
    "## 16. 線形補正\n",
    "\n",
    "線形ゲインを学習する。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9d88e709",
   "metadata": {},
   "outputs": [],
   "source": [
    "results_linear = pd.DataFrame()\n",
    "results_linear_history = pd.DataFrame()\n",
    "results_linear_gain = pd.DataFrame()\n",
    "\n",
    "if stage_enabled(\"linear\"):\n",
    "    t0 = time.perf_counter()\n",
    "    try:\n",
    "        frames = []\n",
    "        history_frames = []\n",
    "        gain_rows = []\n",
    "        shapes = [\"ramp\"] if RUN_STAGE == \"smoke\" else [\"step\", \"ramp\", \"random_walk\"]\n",
    "        outer = progress(CFG.seeds, desc=\"linear seeds\", total=len(CFG.seeds), leave=True, unit=\"seed\")\n",
    "        for seed in outer:\n",
    "            bundle = build_model_bundle(CFG, seed)\n",
    "            training_data, training_Z = build_condition_from_bundle(\n",
    "                CFG,\n",
    "                seed,\n",
    "                bundle,\n",
    "                disturbance_shape=\"ramp\",\n",
    "                disturbance_strength=CFG.disturbance_strength,\n",
    "            )\n",
    "            gain, history, gain_val, best_epoch = train_gain(\n",
    "                LinearResyncGain(CFG),\n",
    "                training_Z,\n",
    "                training_data,\n",
    "                bundle[\"dt_model\"],\n",
    "                bundle[\"q_head\"],\n",
    "                CFG,\n",
    "                seed,\n",
    "                \"linear gain\",\n",
    "            )\n",
    "            history[\"seed\"] = seed\n",
    "            history_frames.append(history)\n",
    "            gain_rows.append({\n",
    "                \"seed\": seed,\n",
    "                \"gain_val_loss\": gain_val,\n",
    "                \"best_epoch\": best_epoch,\n",
    "                **{f\"k_{i}\": float(v) for i, v in enumerate(gain.k.detach().cpu().numpy())},\n",
    "            })\n",
    "\n",
    "            for shape in shapes:\n",
    "                data, Z = build_condition_from_bundle(\n",
    "                    CFG,\n",
    "                    seed,\n",
    "                    bundle,\n",
    "                    disturbance_shape=shape,\n",
    "                    disturbance_strength=CFG.disturbance_strength,\n",
    "                )\n",
    "                frames.append(evaluate_resync_methods(\n",
    "                    data,\n",
    "                    bundle[\"dt_model\"],\n",
    "                    bundle[\"q_head\"],\n",
    "                    Z,\n",
    "                    CFG,\n",
    "                    seed,\n",
    "                    gain=gain,\n",
    "                    gain_name=\"past_state_linear\",\n",
    "                    include_oracle=True,\n",
    "                ))\n",
    "        outer.close()\n",
    "        results_linear = pd.concat(frames, ignore_index=True) if frames else pd.DataFrame()\n",
    "        results_linear_history = pd.concat(history_frames, ignore_index=True) if history_frames else pd.DataFrame()\n",
    "        results_linear_gain = pd.DataFrame(gain_rows)\n",
    "        save_table(\"04_linear_raw\", results_linear)\n",
    "        save_table(\"04_linear_summary\", summarize_table(\n",
    "            results_linear,\n",
    "            [\"disturbance_shape\", \"method\"],\n",
    "            [\"future_lab_obs_abs_error\", \"future_lab_true_abs_error_diagnostic\"] + [f\"dense_true_mae_h{h}\" for h in CFG.dense_horizons],\n",
    "        ))\n",
    "        save_table(\"05_linear_history\", results_linear_history)\n",
    "        save_table(\"06_linear_gain\", results_linear_gain)\n",
    "        record_timing(\"linear\", time.perf_counter() - t0)\n",
    "    except Exception as exc:\n",
    "        record_error(\"linear\", exc)\n",
    "        raise\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1871324e",
   "metadata": {},
   "source": [
    "## 17. 条件を変える\n",
    "\n",
    "外乱、遅延、欠測、ノイズなどを変える。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "efa6d312",
   "metadata": {},
   "outputs": [],
   "source": [
    "results_robustness = pd.DataFrame()\n",
    "\n",
    "if stage_enabled(\"robustness\"):\n",
    "    t0 = time.perf_counter()\n",
    "    try:\n",
    "        frames = []\n",
    "        conditions = ([\n",
    "            {\"factor\": \"smoke\", \"level\": \"base\"}\n",
    "        ] if RUN_STAGE == \"smoke\" else [\n",
    "            {\"factor\": \"shape\", \"level\": \"step\", \"disturbance_shape\": \"step\"},\n",
    "            {\"factor\": \"shape\", \"level\": \"ramp\", \"disturbance_shape\": \"ramp\"},\n",
    "            {\"factor\": \"shape\", \"level\": \"random_walk\", \"disturbance_shape\": \"random_walk\"},\n",
    "            {\"factor\": \"strength\", \"level\": \"0.10\", \"disturbance_strength\": 0.10},\n",
    "            {\"factor\": \"strength\", \"level\": \"0.25\", \"disturbance_strength\": 0.25},\n",
    "            {\"factor\": \"strength\", \"level\": \"0.35\", \"disturbance_strength\": 0.35},\n",
    "            {\"factor\": \"delay\", \"level\": \"20\", \"delay\": 20},\n",
    "            {\"factor\": \"delay\", \"level\": \"40\", \"delay\": 40},\n",
    "            {\"factor\": \"delay\", \"level\": \"80\", \"delay\": 80},\n",
    "            {\"factor\": \"test_missing_rate\", \"level\": \"0.00\", \"test_missing_rate\": 0.00},\n",
    "            {\"factor\": \"test_missing_rate\", \"level\": \"0.10\", \"test_missing_rate\": 0.10},\n",
    "            {\"factor\": \"test_missing_rate\", \"level\": \"0.20\", \"test_missing_rate\": 0.20},\n",
    "            {\"factor\": \"quality_noise_std\", \"level\": \"0.05\", \"quality_noise_std\": 0.05},\n",
    "            {\"factor\": \"quality_noise_std\", \"level\": \"0.12\", \"quality_noise_std\": 0.12},\n",
    "            {\"factor\": \"quality_noise_std\", \"level\": \"0.30\", \"quality_noise_std\": 0.30},\n",
    "            {\"factor\": \"outlier_rate\", \"level\": \"0.00\", \"outlier_rate\": 0.00},\n",
    "            {\"factor\": \"outlier_rate\", \"level\": \"0.05\", \"outlier_rate\": 0.05},\n",
    "            {\"factor\": \"outlier_rate\", \"level\": \"0.10\", \"outlier_rate\": 0.10},\n",
    "        ])\n",
    "        jobs = [(seed, cond) for seed in CFG.robustness_seeds for cond in conditions]\n",
    "        outer = progress(jobs, desc=\"robustness conditions\", total=len(jobs), leave=True, unit=\"cond\")\n",
    "        gains = {}\n",
    "        for seed, cond in outer:\n",
    "            bundle = build_model_bundle(CFG, seed)\n",
    "            if seed not in gains:\n",
    "                train_data, train_Z = build_condition_from_bundle(\n",
    "                    CFG,\n",
    "                    seed,\n",
    "                    bundle,\n",
    "                    disturbance_shape=\"ramp\",\n",
    "                    disturbance_strength=CFG.disturbance_strength,\n",
    "                )\n",
    "                gains[seed], _, _, _ = train_gain(\n",
    "                    LinearResyncGain(CFG),\n",
    "                    train_Z,\n",
    "                    train_data,\n",
    "                    bundle[\"dt_model\"],\n",
    "                    bundle[\"q_head\"],\n",
    "                    CFG,\n",
    "                    seed,\n",
    "                    \"linear gain robustness\",\n",
    "                )\n",
    "\n",
    "            kwargs = {\n",
    "                \"disturbance_shape\": \"ramp\",\n",
    "                \"disturbance_strength\": CFG.disturbance_strength,\n",
    "            }\n",
    "            kwargs.update({k: v for k, v in cond.items() if k not in {\"factor\", \"level\"}})\n",
    "            data, Z = build_condition_from_bundle(CFG, seed, bundle, **kwargs)\n",
    "            frame = evaluate_resync_methods(\n",
    "                data,\n",
    "                bundle[\"dt_model\"],\n",
    "                bundle[\"q_head\"],\n",
    "                Z,\n",
    "                CFG,\n",
    "                seed,\n",
    "                gain=gains[seed],\n",
    "                gain_name=\"past_state_linear\",\n",
    "                include_oracle=False,\n",
    "            )\n",
    "            frame[\"factor\"] = cond[\"factor\"]\n",
    "            frame[\"level\"] = cond[\"level\"]\n",
    "            frames.append(frame)\n",
    "        outer.close()\n",
    "        results_robustness = pd.concat(frames, ignore_index=True) if frames else pd.DataFrame()\n",
    "        save_table(\"07_robustness_raw\", results_robustness)\n",
    "        save_table(\"07_robustness_summary\", summarize_table(\n",
    "            results_robustness,\n",
    "            [\"factor\", \"level\", \"method\"],\n",
    "            [\"future_lab_obs_abs_error\", \"future_lab_true_abs_error_diagnostic\"] + [f\"dense_true_mae_h{h}\" for h in CFG.dense_horizons],\n",
    "        ))\n",
    "        record_timing(\"robustness\", time.perf_counter() - t0)\n",
    "    except Exception as exc:\n",
    "        record_error(\"robustness\", exc)\n",
    "        raise\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "59c89a71",
   "metadata": {},
   "source": [
    "## 18. 非線形補正\n",
    "\n",
    "線形補正が良ければ非線形も試す。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "47f7990b",
   "metadata": {},
   "outputs": [],
   "source": [
    "results_nonlinear = pd.DataFrame()\n",
    "results_nonlinear_history = pd.DataFrame()\n",
    "\n",
    "if stage_enabled(\"nonlinear\"):\n",
    "    t0 = time.perf_counter()\n",
    "    try:\n",
    "        frames = []\n",
    "        histories = []\n",
    "        outer = progress(CFG.seeds, desc=\"nonlinear seeds\", total=len(CFG.seeds), leave=True, unit=\"seed\")\n",
    "        for seed in outer:\n",
    "            bundle = build_model_bundle(CFG, seed)\n",
    "            data, Z = build_condition_from_bundle(\n",
    "                CFG,\n",
    "                seed,\n",
    "                bundle,\n",
    "                disturbance_shape=\"ramp\",\n",
    "                disturbance_strength=CFG.disturbance_strength,\n",
    "            )\n",
    "            linear_gain, _, _, _ = train_gain(\n",
    "                LinearResyncGain(CFG),\n",
    "                Z,\n",
    "                data,\n",
    "                bundle[\"dt_model\"],\n",
    "                bundle[\"q_head\"],\n",
    "                CFG,\n",
    "                seed,\n",
    "                \"linear comparison\",\n",
    "            )\n",
    "            nonlinear_gain, history, val, best_epoch = train_gain(\n",
    "                NonlinearResyncGain(CFG),\n",
    "                Z,\n",
    "                data,\n",
    "                bundle[\"dt_model\"],\n",
    "                bundle[\"q_head\"],\n",
    "                CFG,\n",
    "                seed,\n",
    "                \"nonlinear gain\",\n",
    "            )\n",
    "            history[\"seed\"] = seed\n",
    "            history[\"best_epoch\"] = best_epoch\n",
    "            history[\"best_val\"] = val\n",
    "            histories.append(history)\n",
    "            linear_frame = evaluate_resync_methods(\n",
    "                data,\n",
    "                bundle[\"dt_model\"],\n",
    "                bundle[\"q_head\"],\n",
    "                Z,\n",
    "                CFG,\n",
    "                seed,\n",
    "                gain=linear_gain,\n",
    "                gain_name=\"past_state_linear\",\n",
    "                include_oracle=False,\n",
    "            )\n",
    "            nonlinear_frame = evaluate_resync_methods(\n",
    "                data,\n",
    "                bundle[\"dt_model\"],\n",
    "                bundle[\"q_head\"],\n",
    "                Z,\n",
    "                CFG,\n",
    "                seed,\n",
    "                gain=nonlinear_gain,\n",
    "                gain_name=\"past_state_nonlinear\",\n",
    "                include_oracle=False,\n",
    "            )\n",
    "            # baselineはlinear_frame側に一度だけ残し、二重計上を避ける。\n",
    "            nonlinear_frame = nonlinear_frame[\n",
    "                nonlinear_frame[\"method\"] == \"past_state_nonlinear\"\n",
    "            ].copy()\n",
    "            frames.extend([linear_frame, nonlinear_frame])\n",
    "        outer.close()\n",
    "        results_nonlinear = pd.concat(frames, ignore_index=True) if frames else pd.DataFrame()\n",
    "        results_nonlinear_history = pd.concat(histories, ignore_index=True) if histories else pd.DataFrame()\n",
    "        save_table(\"08_nonlinear_raw\", results_nonlinear)\n",
    "        save_table(\"08_nonlinear_summary\", summarize_table(\n",
    "            results_nonlinear,\n",
    "            [\"method\"],\n",
    "            [\"future_lab_obs_abs_error\", \"future_lab_true_abs_error_diagnostic\"] + [f\"dense_true_mae_h{h}\" for h in CFG.dense_horizons],\n",
    "        ))\n",
    "        save_table(\"09_nonlinear_history\", results_nonlinear_history)\n",
    "        record_timing(\"nonlinear\", time.perf_counter() - t0)\n",
    "    except Exception as exc:\n",
    "        record_error(\"nonlinear\", exc)\n",
    "        raise\n"
   ]
  },
