    "## 8. DTモデル\n",
    "\n",
    "latentを時間発展させ、得られたセンサで少し直す。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "af935d0b",
   "metadata": {},
   "outputs": [],
   "source": [
    "class FilterSequenceDataset(Dataset):\n",
    "    def __init__(self, data, start, end, init_history, rollout):\n",
    "        self.X = torch.from_numpy(data[\"X\"])\n",
    "        self.U = torch.from_numpy(data[\"U\"])\n",
    "        self.M = torch.from_numpy(data[\"mask\"])\n",
    "        self.init_history = int(init_history)\n",
    "        self.rollout = int(rollout)\n",
    "        lo = max(int(start) + self.init_history, self.init_history)\n",
    "        hi = min(int(end) - self.rollout + 1, len(self.X) - self.rollout + 1)\n",
    "        self.times = np.arange(lo, max(lo, hi), dtype=int)\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.times)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        t = int(self.times[idx])\n",
    "        return (\n",
    "            self.X[t - self.init_history:t],\n",
    "            self.U[t - self.init_history:t],\n",
    "            self.M[t - self.init_history:t],\n",
    "            self.U[t:t + self.rollout],\n",
    "            self.X[t:t + self.rollout],\n",
    "            self.M[t:t + self.rollout],\n",
    "        )\n",
    "\n",
    "\n",
    "class AssimilatingLatentDT(nn.Module):\n",
    "    def __init__(self, cfg):\n",
    "        super().__init__()\n",
    "        self.x_dim = cfg.x_dim\n",
    "        self.u_dim = cfg.u_dim\n",
    "        self.z_dim = cfg.z_dim\n",
    "        self.slow_dim = cfg.slow_dim\n",
    "        self.slow_prior_scale = cfg.slow_prior_scale\n",
    "        self.slow_assim_scale = cfg.slow_assim_scale\n",
    "\n",
    "        init_input_dim = cfg.x_dim + cfg.u_dim + cfg.x_dim\n",
    "        self.init_encoder = nn.GRU(\n",
    "            init_input_dim,\n",
    "            cfg.hidden_dim,\n",
    "            batch_first=True,\n",
    "        )\n",
    "        self.init_to_z = nn.Sequential(\n",
    "            nn.LayerNorm(cfg.hidden_dim),\n",
    "            nn.Linear(cfg.hidden_dim, cfg.z_dim),\n",
    "        )\n",
    "        self.prior_net = nn.Sequential(\n",
    "            nn.LayerNorm(cfg.z_dim + cfg.u_dim),\n",
    "            nn.Linear(cfg.z_dim + cfg.u_dim, cfg.hidden_dim),\n",
    "            nn.GELU(),\n",
    "            nn.Linear(cfg.hidden_dim, cfg.z_dim),\n",
    "        )\n",
    "        self.sensor_decoder = nn.Sequential(\n",
    "            nn.LayerNorm(cfg.z_dim),\n",
    "            nn.Linear(cfg.z_dim, cfg.hidden_dim),\n",
    "            nn.GELU(),\n",
    "            nn.Linear(cfg.hidden_dim, cfg.x_dim),\n",
    "        )\n",
    "        assim_input_dim = cfg.z_dim + cfg.x_dim + cfg.x_dim\n",
    "        self.assim_net = nn.Sequential(\n",
    "            nn.LayerNorm(assim_input_dim),\n",
    "            nn.Linear(assim_input_dim, cfg.hidden_dim),\n",
    "            nn.GELU(),\n",
    "            nn.Linear(cfg.hidden_dim, cfg.z_dim),\n",
    "        )\n",
    "\n",
    "    def _scale_slow(self, delta, scale):\n",
    "        if self.slow_dim <= 0:\n",
    "            return delta\n",
    "        fast = delta[..., :-self.slow_dim]\n",
    "        slow = delta[..., -self.slow_dim:] * scale\n",
    "        return torch.cat([fast, slow], dim=-1)\n",
    "\n",
    "    def initialize(self, x_hist, u_hist, m_hist):\n",
    "        inp = torch.cat([x_hist, u_hist, m_hist], dim=-1)\n",
    "        _, h = self.init_encoder(inp)\n",
    "        return self.init_to_z(h[-1])\n",
    "\n",
    "    def prior(self, z, u_prev):\n",
    "        delta = self.prior_net(torch.cat([z, u_prev], dim=-1))\n",
    "        return z + self._scale_slow(delta, self.slow_prior_scale)\n",
    "\n",
    "    def decode_sensor(self, z):\n",
    "        return self.sensor_decoder(z)\n",
    "\n",
    "    def assimilate(self, z_prior, x_t, m_t):\n",
    "        x_prior = self.decode_sensor(z_prior)\n",
    "        innovation = (x_t - x_prior) * m_t\n",
    "        corr = self.assim_net(torch.cat([z_prior, innovation, m_t], dim=-1))\n",
    "        corr = self._scale_slow(corr, self.slow_assim_scale)\n",
    "        return z_prior + corr\n",
    "\n",
    "    def step(self, z, u_prev, x_t, m_t):\n",
    "        z_prior = self.prior(z, u_prev)\n",
    "        x_prior = self.decode_sensor(z_prior)\n",
    "        z_post = self.assimilate(z_prior, x_t, m_t)\n",
    "        x_post = self.decode_sensor(z_post)\n",
    "        return z_post, x_prior, x_post\n",
    "\n",
    "    def forward_chunk(self, x_hist, u_hist, m_hist, u_prev, x_future, m_future):\n",
    "        z = self.initialize(x_hist, u_hist, m_hist)\n",
    "        prior_preds = []\n",
    "        post_preds = []\n",
    "        states = []\n",
    "        for k in range(x_future.shape[1]):\n",
    "            z, x_prior, x_post = self.step(\n",
    "                z,\n",
    "                u_prev[:, k],\n",
    "                x_future[:, k],\n",
    "                m_future[:, k],\n",
    "            )\n",
    "            prior_preds.append(x_prior)\n",
    "            post_preds.append(x_post)\n",
    "            states.append(z)\n",
    "        return (\n",
    "            torch.stack(prior_preds, dim=1),\n",
    "            torch.stack(post_preds, dim=1),\n",
    "            torch.stack(states, dim=1),\n",
    "        )\n"
   ]
  },
