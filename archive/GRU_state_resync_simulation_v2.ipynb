    "        dense_horizons=(5, 10),\n",
    "        oracle_steps=2,\n",
    "        oracle_max_events=1,\n",
    "        seeds=(42,),\n",
    "        robustness_seeds=(42,),\n",
    "        disturbance_ramp_length=120,\n",
    "    )\n",
    "\n",
    "\n",
    "CFG = make_runtime_config(BASE_CFG)\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "VALID_STAGES = {\"smoke\", \"necessity\", \"linear\", \"robustness\", \"nonlinear\", \"all\"}\n",
    "if CFG.run_stage not in VALID_STAGES:\n",
    "    raise ValueError(f\"unknown run_stage: {CFG.run_stage}\")\n",
    "\n",
    "print(\"run_stage:\", CFG.run_stage)\n",
    "print(\"device:\", DEVICE)\n",
    "print(\"T:\", CFG.T)\n"
   ]
