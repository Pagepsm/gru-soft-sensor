    "## 6. 発酵プロセスのシミュレーター\n",
    "\n",
    "菌体、基質、製品、溶存酸素を作る。センサで見えにくい内部活性も入れた。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a05038c3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def make_activity_path(cfg, seed, disturbance_shape, disturbance_strength, disturbance_start):\n",
    "    rng = np.random.default_rng(seed + 11_000)\n",
    "    activity = np.ones(cfg.T, dtype=np.float32)\n",
    "\n",
    "    # 通常運転中にも小さなロット差・生物活性変動を入れる。\n",
    "    for t in range(1, cfg.T):\n",
    "        deviation = 0.997 * (float(activity[t - 1]) - 1.0)\n",
    "        activity[t] = 1.0 + deviation + rng.normal(0.0, 0.0012)\n",
    "        activity[t] = np.clip(activity[t], 0.90, 1.10)\n",
    "\n",
    "    if disturbance_shape == \"none\":\n",
    "        return activity\n",
    "\n",
    "    start = int(disturbance_start)\n",
    "    if not (0 <= start < cfg.T):\n",
    "        raise ValueError(\"invalid disturbance_start\")\n",
    "\n",
    "    if disturbance_shape == \"step\":\n",
    "        shift = np.zeros(cfg.T, dtype=np.float32)\n",
    "        shift[start:] = disturbance_strength\n",
    "    elif disturbance_shape == \"ramp\":\n",
    "        shift = np.zeros(cfg.T, dtype=np.float32)\n",
    "        n = max(1, min(cfg.disturbance_ramp_length, cfg.T - start))\n",
    "        shift[start:start + n] = np.linspace(0.0, disturbance_strength, n, dtype=np.float32)\n",
    "        if start + n < cfg.T:\n",
    "            shift[start + n:] = disturbance_strength\n",
    "    elif disturbance_shape == \"random_walk\":\n",
    "        shift = np.zeros(cfg.T, dtype=np.float32)\n",
    "        rw_rng = np.random.default_rng(seed + 12_000)\n",
    "        target = 0.0\n",
    "        for t in range(start, cfg.T):\n",
    "            target = 0.998 * target + rw_rng.normal(\n",
    "                disturbance_strength / 900.0,\n",
    "                disturbance_strength / 250.0,\n",
    "            )\n",
    "            shift[t] = np.clip(target, 0.0, disturbance_strength)\n",
    "    else:\n",
    "        raise ValueError(f\"unknown disturbance_shape: {disturbance_shape}\")\n",
    "\n",
    "    return np.clip(activity - shift, 0.55, 1.15).astype(np.float32)\n",
    "\n",
    "\n",
    "def make_missing_mask(cfg, seed, train_end, val_end, test_missing_rate=None):\n",
    "    rng = np.random.default_rng(seed + 21_000)\n",
    "    mask = np.ones((cfg.T, cfg.x_dim), dtype=np.float32)\n",
    "    test_rate = cfg.test_missing_rate if test_missing_rate is None else test_missing_rate\n",
    "    rates = np.full(cfg.T, cfg.missing_rate, dtype=np.float32)\n",
    "    rates[val_end:] = float(test_rate)\n",
    "    random_missing = rng.random(mask.shape) < rates[:, None]\n",
    "    mask[random_missing] = 0.0\n",
    "\n",
    "    # 短い連続欠測を追加する。\n",
    "    for t in range(1, cfg.T - 1):\n",
    "        if rng.random() < cfg.outage_probability:\n",
    "            j = int(rng.integers(0, cfg.x_dim))\n",
    "            length = int(rng.integers(2, cfg.outage_max_length + 1))\n",
    "            mask[t:min(cfg.T, t + length), j] = 0.0\n",
    "    mask[0] = 1.0\n",
    "    return mask\n",
    "\n",
    "\n",
    "def simulate_fermentation(\n",
    "    cfg,\n",
    "    seed,\n",
    "    disturbance_shape=None,\n",
    "    disturbance_strength=None,\n",
    "    test_missing_rate=None,\n",
    "):\n",
    "    disturbance_shape = cfg.disturbance_shape if disturbance_shape is None else disturbance_shape\n",
    "    disturbance_strength = (\n",
    "        cfg.disturbance_strength\n",
    "        if disturbance_strength is None\n",
    "        else float(disturbance_strength)\n",
    "    )\n",
    "    train_end, val_end = split_bounds(cfg.T, cfg.train_ratio, cfg.val_ratio)\n",
    "    activity = make_activity_path(\n",
    "        cfg,\n",
    "        seed,\n",
    "        disturbance_shape,\n",
    "        disturbance_strength,\n",
    "        val_end,\n",
    "    )\n",
    "\n",
    "    process_rng = np.random.default_rng(seed)\n",
    "    sensor_rng = np.random.default_rng(seed + 10_000)\n",
    "\n",
    "    # B: biomass, S: substrate, P: product, O: dissolved oxygen\n",
    "    S_true = np.zeros((cfg.T, 4), dtype=np.float32)\n",
    "    X_clean = np.zeros((cfg.T, cfg.x_dim), dtype=np.float32)\n",
    "    U = np.zeros((cfg.T, cfg.u_dim), dtype=np.float32)\n",
    "    S_true[0] = np.array([1.20, 7.50, 0.20, 0.58], dtype=np.float32)\n",
    "\n",
    "    do_setpoint = 0.58\n",
    "    integral_error = 0.0\n",
    "    feed_prbs = 0.0\n",
    "\n",
    "    mu_max = 0.24\n",
    "    ks = 0.45\n",
    "    ko = 0.12\n",
    "    kd = 0.006\n",
    "    yxs = 0.58\n",
    "    qp_max = 0.105\n",
    "    kps = 0.70\n",
    "    substrate_in = 28.0\n",
    "    volume = 10.0\n",
    "\n",
    "    def sensors_from_state(state, act, feed, aer):\n",
    "        biomass, substrate, _, oxygen = state\n",
    "        mu = act * mu_max * substrate / (ks + substrate) * oxygen / (ko + oxygen)\n",
    "        our = mu * biomass\n",
    "        return np.array([\n",
    "            oxygen,\n",
    "            np.log1p(max(biomass, 0.0)),\n",
    "            our,\n",
    "            0.52 * our + 0.04 * feed,\n",
    "            0.11 * substrate + 0.015 * biomass,\n",
    "        ], dtype=np.float32)\n",
    "\n",
    "    X_clean[0] = sensors_from_state(S_true[0], activity[0], 0.07, 1.2)\n",
    "\n",
    "    for t in range(1, cfg.T):\n",
    "        biomass, substrate, product, oxygen = [float(v) for v in S_true[t - 1]]\n",
    "\n",
    "        # 計画供給と小さなPRBS励起。\n",
    "        if t % 240 == 0:\n",
    "            feed_prbs = float(process_rng.normal(0.0, 0.012))\n",
    "        feed_plan = 0.072 + 0.014 * math.sin(2.0 * math.pi * t / 720.0) + feed_prbs\n",
    "        feed = float(np.clip(feed_plan, 0.035, 0.115))\n",
    "\n",
    "        # 溶存酸素の閉ループ制御。\n",
    "        do_measurement = oxygen + sensor_rng.normal(0.0, 0.006)\n",
    "        error = do_setpoint - do_measurement\n",
    "        integral_error = float(np.clip(integral_error + error, -10.0, 10.0))\n",
    "        aeration = 1.15 + 3.2 * error + 0.055 * integral_error\n",
    "        aeration += 0.08 * math.sin(2.0 * math.pi * t / 500.0)\n",
    "        aeration = float(np.clip(aeration, 0.25, 3.00))\n",
    "        U[t - 1] = np.array([feed, aeration], dtype=np.float32)\n",
    "\n",
    "        act = float(activity[t - 1])\n",
    "        mu = act * mu_max * substrate / (ks + substrate) * oxygen / (ko + oxygen)\n",
    "        dilution = feed / volume\n",
    "        product_rate = (0.55 + 0.45 * act) * qp_max * substrate / (kps + substrate) * biomass\n",
    "        kla = 0.30 + 0.19 * aeration\n",
    "        oxygen_uptake = 0.62 * mu * biomass\n",
    "\n",
    "        d_biomass = mu * biomass - kd * biomass - dilution * biomass\n",
    "        d_substrate = dilution * (substrate_in - substrate) - mu * biomass / yxs\n",
    "        d_product = product_rate - dilution * product\n",
    "        d_oxygen = kla * (1.0 - oxygen) - oxygen_uptake\n",
    "\n",
    "        noise = process_rng.normal(0.0, [0.0015, 0.006, 0.0010, 0.0018])\n",
    "        next_state = np.array([\n",
    "            biomass + cfg.dt_hours * d_biomass,\n",
    "            substrate + cfg.dt_hours * d_substrate,\n",
    "            product + cfg.dt_hours * d_product,\n",
    "            oxygen + cfg.dt_hours * d_oxygen,\n",
    "        ]) + noise\n",
    "        next_state = np.clip(\n",
    "            next_state,\n",
    "            [0.05, 0.02, 0.0, 0.02],\n",
    "            [20.0, 35.0, 30.0, 1.20],\n",
    "        )\n",
    "        S_true[t] = next_state.astype(np.float32)\n",
    "        X_clean[t] = sensors_from_state(S_true[t], activity[t], feed, aeration)\n",
    "\n",
    "    U[-1] = U[-2]\n",
    "    sensor_std = np.array([0.010, 0.018, 0.035, 0.025, 0.030], dtype=np.float32)\n",
    "    X_noisy = X_clean + sensor_rng.normal(0.0, sensor_std, size=X_clean.shape)\n",
    "    mask = make_missing_mask(cfg, seed, train_end, val_end, test_missing_rate)\n",
    "    X_obs = X_noisy.astype(np.float32)\n",
    "    X_obs[mask == 0.0] = np.nan\n",
    "\n",
    "    q_true = S_true[:, 2].astype(np.float32)\n",
    "    return {\n",
    "        \"X_clean\": X_clean.astype(np.float32),\n",
    "        \"X_obs\": X_obs,\n",
    "        \"mask\": mask.astype(np.float32),\n",
    "        \"U_raw\": U.astype(np.float32),\n",
    "        \"state_true\": S_true.astype(np.float32),\n",
    "        \"activity_true\": activity.astype(np.float32),\n",
    "        \"q_true\": q_true,\n",
    "        \"train_end\": train_end,\n",
    "        \"val_end\": val_end,\n",
    "        \"disturbance_shape\": disturbance_shape,\n",
    "        \"disturbance_strength\": disturbance_strength,\n",
    "    }\n"
   ]
  },
