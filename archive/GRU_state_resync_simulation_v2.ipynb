   "source": [
    "@dataclass\n",
    "class Config:\n",
    "    # smoke / necessity / linear / robustness / nonlinear / all\n",
    "    run_stage: str = \"smoke\"\n",
    "\n",
    "    # 保存\n",
    "    use_google_drive: bool = False\n",
    "    google_drive_parent: str = \"/content/drive/MyDrive/gru-soft-sensor-demo\"\n",
    "    result_folder_name: str = \"GRU_state_resync_simulation_v2_results\"\n",
    "    show_progress: bool = True\n",
    "\n",
    "    # データ長と分割\n",
    "    T: int = 9000\n",
    "    train_ratio: float = 0.60\n",
    "    val_ratio: float = 0.20\n",
    "    dt_hours: float = 0.05\n",
    "\n",
    "    # 低頻度・遅延品質\n",
    "    quality_interval: int = 150\n",
    "    delay: int = 40\n",
    "    quality_noise_std: float = 0.12\n",
    "    outlier_rate: float = 0.05\n",
    "    outlier_std: float = 0.60\n",
    "\n",
    "    # センサ欠測\n",
    "    missing_rate: float = 0.03\n",
    "    test_missing_rate: float = 0.03\n",
    "    outage_probability: float = 0.0008\n",
    "    outage_max_length: int = 8\n",
    "\n",
    "    # 内部活性ずれ\n",
    "    disturbance_shape: str = \"ramp\"\n",
    "    disturbance_strength: float = 0.25\n",
    "    disturbance_ramp_length: int = 450\n",
    "\n",
    "    # DT\n",
    "    x_dim: int = 5\n",
    "    u_dim: int = 2\n",
    "    z_dim: int = 8\n",
    "    slow_dim: int = 2\n",
    "    hidden_dim: int = 64\n",
    "    init_history: int = 48\n",
    "    train_rollout: int = 24\n",
    "    batch_size: int = 128\n",
    "    epochs_dt: int = 60\n",
    "    patience_dt: int = 8\n",
    "    lr_dt: float = 1.0e-3\n",
    "    weight_decay: float = 1.0e-5\n",
    "    slow_prior_scale: float = 0.08\n",
    "    slow_assim_scale: float = 0.04\n",
    "    recon_weight: float = 0.25\n",
    "    slow_smooth_weight: float = 1.0e-4\n",
    "\n",
    "    # 品質モデル\n",
    "    quality_hidden_dim: int = 32\n",
    "    quality_batch_size: int = 64\n",
    "    epochs_quality: int = 80\n",
    "    patience_quality: int = 10\n",
    "    lr_quality: float = 1.0e-3\n",
    "\n",
    "    # 再同期\n",
    "    correction_cap: float = 2.5\n",
    "    gain_epochs: int = 80\n",
    "    gain_patience: int = 10\n",
    "    gain_batch_size: int = 16\n",
    "    gain_lr: float = 2.0e-2\n",
    "    gain_regularization: float = 2.0e-3\n",
    "    gain_current_weight: float = 0.35\n",
    "    gain_future_weight: float = 1.0\n",
    "    innovation_clip: float = 3.0\n",
    "    bias_decay_steps: float = 150.0\n",
    "    online_head_steps: int = 3\n",
    "    online_head_lr: float = 2.0e-2\n",
    "\n",
    "    # 評価\n",
    "    dense_horizons: tuple = (20, 40, 50)\n",
    "    oracle_steps: int = 30\n",
    "    oracle_lr: float = 0.08\n",
    "    oracle_regularization: float = 1.0e-3\n",
    "    oracle_max_events: int = 12\n",
    "\n",
    "    # 再現性\n",
    "    seeds: tuple = (42, 43, 44, 45, 46)\n",
    "    robustness_seeds: tuple = (42, 43, 44)\n",
    "\n",
    "\n",
    "BASE_CFG = Config()\n",
    "\n",
    "\n",
    "def make_runtime_config(cfg):\n",
    "    if cfg.run_stage != \"smoke\":\n",
    "        return cfg\n",
    "    return replace(\n",
    "        cfg,\n",
    "        T=1800,\n",
    "        quality_interval=150,\n",
    "        init_history=24,\n",
    "        train_rollout=8,\n",
    "        batch_size=64,\n",
