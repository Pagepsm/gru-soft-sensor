   "source": [
    "MODEL_CACHE = {}\n",
    "\n",
    "\n",
    "def build_model_bundle(cfg, seed):\n",
    "    key = (seed, cfg.T, cfg.z_dim, cfg.slow_dim, cfg.init_history, cfg.train_rollout)\n",
    "    if key in MODEL_CACHE:\n",
    "        return MODEL_CACHE[key]\n",
    "\n",
    "    base_data = build_data(\n",
    "        cfg,\n",
    "        seed,\n",
    "        disturbance_shape=\"none\",\n",
    "        disturbance_strength=0.0,\n",
    "    )\n",
    "    dt_model, dt_history, dt_val, persistence_val, dt_best_epoch = train_dt(base_data, cfg, seed)\n",
    "    Z = extract_latent_trajectory(dt_model, base_data, cfg, desc=f\"latent base | seed={seed}\")\n",
    "    q_head, q_history, q_val, q_best_epoch = train_quality_head(Z, base_data, cfg, seed)\n",
    "    bundle = {\n",
    "        \"base_data\": base_data,\n",
    "        \"reference_stats\": reference_stats_from_data(base_data),\n",
    "        \"dt_model\": dt_model,\n",
    "        \"Z_base\": Z,\n",
    "        \"q_head\": q_head,\n",
    "        \"dt_history\": dt_history,\n",
    "        \"q_history\": q_history,\n",
    "        \"dt_val\": dt_val,\n",
    "        \"persistence_val\": persistence_val,\n",
    "        \"dt_best_epoch\": dt_best_epoch,\n",
    "        \"q_val\": q_val,\n",
    "        \"q_best_epoch\": q_best_epoch,\n",
    "    }\n",
    "    MODEL_CACHE[key] = bundle\n",
    "    return bundle\n",
    "\n",
    "\n",
    "def build_condition_from_bundle(cfg, seed, bundle, **kwargs):\n",
    "    data = build_data(\n",
    "        cfg,\n",
    "        seed,\n",
    "        reference_stats=bundle[\"reference_stats\"],\n",
    "        **kwargs,\n",
    "    )\n",
    "    Z = extract_latent_trajectory(\n",
    "        bundle[\"dt_model\"],\n",
    "        data,\n",
    "        cfg,\n",
    "        desc=f\"latent | seed={seed} | {data['disturbance_shape']}\",\n",
    "    )\n",
    "    return data, Z\n"
   ]
