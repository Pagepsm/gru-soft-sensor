   "source": [
    "## 7. 低頻度・遅延品質データと前処理\n",
    "\n",
    "ラボ分析にはノイズと遅延がある。届いていないラベルは学習に使わない。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c29ac288",
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_data(\n",
    "    cfg,\n",
    "    seed,\n",
    "    disturbance_shape=None,\n",
    "    disturbance_strength=None,\n",
    "    delay=None,\n",
    "    quality_interval=None,\n",
    "    quality_noise_std=None,\n",
    "    outlier_rate=None,\n",
    "    test_missing_rate=None,\n",
    "    reference_stats=None,\n",
    "):\n",
    "    sim = simulate_fermentation(\n",
    "        cfg,\n",
    "        seed,\n",
    "        disturbance_shape=disturbance_shape,\n",
    "        disturbance_strength=disturbance_strength,\n",
    "        test_missing_rate=test_missing_rate,\n",
    "    )\n",
    "    train_end = sim[\"train_end\"]\n",
    "    val_end = sim[\"val_end\"]\n",
    "\n",
    "    X_fill_raw, fill_mean = forward_fill_observed(sim[\"X_obs\"], train_end)\n",
    "\n",
    "    # U_raw[t]は区間[t,t+1]の操作。DT入力では、X[t]と\n",
    "    # その観測へ到達する区間(t-1,t]の操作を同じindexへ揃える。\n",
    "    U_aligned_raw = np.zeros_like(sim[\"U_raw\"], dtype=np.float32)\n",
    "    U_aligned_raw[0] = 0.0\n",
    "    U_aligned_raw[1:] = sim[\"U_raw\"][:-1]\n",
    "\n",
    "    if reference_stats is None:\n",
    "        X, X_mean, X_std = standardize_from_train(X_fill_raw, train_end)\n",
    "        U, U_mean, U_std = standardize_from_train(U_aligned_raw, train_end)\n",
    "    else:\n",
    "        X_mean = reference_stats[\"X_mean\"]\n",
    "        X_std = reference_stats[\"X_std\"]\n",
    "        U_mean = reference_stats[\"U_mean\"]\n",
    "        U_std = reference_stats[\"U_std\"]\n",
    "        X = apply_standardization(X_fill_raw, X_mean, X_std)\n",
    "        U = apply_standardization(U_aligned_raw, U_mean, U_std)\n",
    "\n",
    "    delay = cfg.delay if delay is None else int(delay)\n",
    "    interval = cfg.quality_interval if quality_interval is None else int(quality_interval)\n",
    "    noise_std = cfg.quality_noise_std if quality_noise_std is None else float(quality_noise_std)\n",
    "    out_rate = cfg.outlier_rate if outlier_rate is None else float(outlier_rate)\n",
    "\n",
    "    start = max(cfg.init_history + 2, interval)\n",
    "    feature_times = np.arange(start, cfg.T - delay, interval, dtype=int)\n",
    "    arrival_times = feature_times + delay\n",
    "    if len(feature_times) < 4:\n",
    "        raise ValueError(\"too few quality measurements\")\n",
    "\n",
    "    rng = np.random.default_rng(seed + 30_000)\n",
    "    q_obs = sim[\"q_true\"][feature_times].astype(np.float32).copy()\n",
    "    q_obs += rng.normal(0.0, noise_std, size=len(q_obs)).astype(np.float32)\n",
    "    outlier_mask = rng.random(len(q_obs)) < out_rate\n",
    "    if np.any(outlier_mask):\n",
    "        q_obs[outlier_mask] += rng.normal(\n",
    "            0.0,\n",
    "            cfg.outlier_std,\n",
    "            size=int(outlier_mask.sum()),\n",
    "        ).astype(np.float32)\n",
    "\n",
    "    # 現場で利用可能な分析信頼度メタデータを模擬する。\n",
    "    confidence = np.clip(\n",
    "        0.92 + rng.normal(0.0, 0.06, size=len(q_obs)),\n",
    "        0.55,\n",
    "        1.00,\n",
    "    ).astype(np.float32)\n",
    "    if np.any(outlier_mask):\n",
    "        confidence[outlier_mask] *= rng.uniform(0.35, 0.80, size=int(outlier_mask.sum())).astype(np.float32)\n",
    "    # 正常測定でも一部は分析装置の品質管理フラグが低い。\n",
    "    low_qc = (~outlier_mask) & (rng.random(len(q_obs)) < 0.08)\n",
    "    confidence[low_qc] *= rng.uniform(0.55, 0.85, size=int(low_qc.sum())).astype(np.float32)\n",
    "\n",
    "    q_train_mask = arrival_times < train_end\n",
    "    q_val_mask = (feature_times >= train_end) & (arrival_times < val_end)\n",
    "    q_test_mask = (feature_times >= val_end) & (arrival_times < cfg.T)\n",
    "\n",
    "    if not q_train_mask.any() or not q_val_mask.any() or not q_test_mask.any():\n",
    "        raise ValueError(\"quality split contains an empty subset\")\n",
    "\n",
    "    if reference_stats is None:\n",
    "        q_mean = np.float32(np.mean(q_obs[q_train_mask]))\n",
    "        q_std = np.float32(max(np.std(q_obs[q_train_mask]), 1.0e-6))\n",
    "    else:\n",
    "        q_mean = np.float32(reference_stats[\"q_mean\"])\n",
    "        q_std = np.float32(reference_stats[\"q_std\"])\n",
    "    q_obs_scaled = ((q_obs - q_mean) / q_std).astype(np.float32)\n",
    "\n",
    "    assert np.all(arrival_times[q_train_mask] < train_end)\n",
    "    assert np.all(feature_times[q_val_mask] >= train_end)\n",
    "    assert np.all(arrival_times[q_val_mask] < val_end)\n",
    "    assert np.all(feature_times[q_test_mask] >= val_end)\n",
    "\n",
    "    data = {\n",
    "        **sim,\n",
    "        \"X_fill_raw\": X_fill_raw.astype(np.float32),\n",
    "        \"X\": X.astype(np.float32),\n",
    "        \"U\": U.astype(np.float32),\n",
    "        \"U_interval_raw\": sim[\"U_raw\"].astype(np.float32),\n",
    "        \"U_aligned_raw\": U_aligned_raw.astype(np.float32),\n",
    "        \"feature_times\": feature_times,\n",
    "        \"arrival_times\": arrival_times,\n",
    "        \"q_obs\": q_obs.astype(np.float32),\n",
    "        \"q_obs_scaled\": q_obs_scaled,\n",
    "        \"q_confidence\": confidence,\n",
    "        \"q_outlier_mask\": outlier_mask,\n",
    "        \"q_train_mask\": q_train_mask,\n",
    "        \"q_val_mask\": q_val_mask,\n",
    "        \"q_test_mask\": q_test_mask,\n",
    "        \"q_mean\": q_mean,\n",
    "        \"q_std\": q_std,\n",
    "        \"X_mean\": X_mean,\n",
    "        \"X_std\": X_std,\n",
    "        \"U_mean\": U_mean,\n",
    "        \"U_std\": U_std,\n",
    "        \"fill_mean\": fill_mean,\n",
    "        \"delay\": delay,\n",
    "        \"quality_interval\": interval,\n",
    "        \"n_train_labels\": int(q_train_mask.sum()),\n",
    "        \"n_val_labels\": int(q_val_mask.sum()),\n",
    "        \"n_test_labels\": int(q_test_mask.sum()),\n",
    "    }\n",
    "    return data\n",
    "\n",
    "\n",
    "def reference_stats_from_data(data):\n",
    "    return {\n",
    "        \"X_mean\": data[\"X_mean\"],\n",
    "        \"X_std\": data[\"X_std\"],\n",
    "        \"U_mean\": data[\"U_mean\"],\n",
    "        \"U_std\": data[\"U_std\"],\n",
    "        \"q_mean\": data[\"q_mean\"],\n",
    "        \"q_std\": data[\"q_std\"],\n",
    "    }\n"
   ]
  },
