   "source": [
    "## 9. DTの学習\n",
    "\n",
    "観測できたセンサだけで学習する。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8d83cd28",
   "metadata": {},
   "outputs": [],
   "source": [
    "def masked_mse(pred, target, mask):\n",
    "    sq = (pred - target) ** 2 * mask\n",
    "    return sq.sum() / mask.sum().clamp_min(1.0)\n",
    "\n",
    "\n",
    "def evaluate_dt(model, loader, cfg):\n",
    "    model.eval()\n",
    "    losses = []\n",
    "    persistence_losses = []\n",
    "    with torch.no_grad():\n",
    "        for batch in loader:\n",
    "            xh, uh, mh, up, xf, mf = [v.to(DEVICE) for v in batch]\n",
    "            prior_pred, post_pred, states = model.forward_chunk(xh, uh, mh, up, xf, mf)\n",
    "            prior_loss = masked_mse(prior_pred, xf, mf)\n",
    "            post_loss = masked_mse(post_pred, xf, mf)\n",
    "            slow = states[..., -cfg.slow_dim:]\n",
    "            slow_loss = ((slow[:, 1:] - slow[:, :-1]) ** 2).mean() if slow.shape[1] > 1 else torch.tensor(0.0, device=DEVICE)\n",
    "            loss = prior_loss + cfg.recon_weight * post_loss + cfg.slow_smooth_weight * slow_loss\n",
    "            losses.append(float(loss.item()))\n",
    "\n",
    "            persistence = xh[:, -1:, :].expand_as(xf)\n",
    "            persistence_losses.append(float(masked_mse(persistence, xf, mf).item()))\n",
    "            if CFG.run_stage == \"smoke\":\n",
    "                break\n",
    "    return float(np.mean(losses)), float(np.mean(persistence_losses))\n",
    "\n",
    "\n",
    "def train_dt(data, cfg, seed):\n",
    "    set_seed(seed)\n",
    "    train_ds = FilterSequenceDataset(\n",
    "        data,\n",
    "        0,\n",
    "        data[\"train_end\"],\n",
    "        cfg.init_history,\n",
    "        cfg.train_rollout,\n",
    "    )\n",
    "    val_ds = FilterSequenceDataset(\n",
    "        data,\n",
    "        data[\"train_end\"],\n",
    "        data[\"val_end\"],\n",
    "        cfg.init_history,\n",
    "        cfg.train_rollout,\n",
    "    )\n",
    "    if len(train_ds) == 0 or len(val_ds) == 0:\n",
    "        raise ValueError(\"empty DT dataset\")\n",
    "\n",
    "    generator = torch.Generator().manual_seed(seed)\n",
    "    train_loader = DataLoader(\n",
    "        train_ds,\n",
    "        batch_size=cfg.batch_size,\n",
    "        shuffle=True,\n",
    "        generator=generator,\n",
    "    )\n",
    "    val_loader = DataLoader(val_ds, batch_size=cfg.batch_size, shuffle=False)\n",
    "\n",
    "    model = AssimilatingLatentDT(cfg).to(DEVICE)\n",
    "    optimizer = torch.optim.AdamW(\n",
    "        model.parameters(),\n",
    "        lr=cfg.lr_dt,\n",
    "        weight_decay=cfg.weight_decay,\n",
    "    )\n",
    "\n",
    "    best_val = float(\"inf\")\n",
    "    best_state = copy.deepcopy(model.state_dict())\n",
    "    best_epoch = 0\n",
    "    wait = 0\n",
    "    history = []\n",
    "\n",
    "    epoch_bar = progress(\n",
    "        range(1, cfg.epochs_dt + 1),\n",
    "        desc=f\"DT | seed={seed}\",\n",
    "        total=cfg.epochs_dt,\n",
    "        leave=False,\n",
    "        unit=\"epoch\",\n",
    "    )\n",
    "    for epoch in epoch_bar:\n",
    "        model.train()\n",
    "        train_values = []\n",
    "        for batch in train_loader:\n",
    "            xh, uh, mh, up, xf, mf = [v.to(DEVICE) for v in batch]\n",
    "            optimizer.zero_grad(set_to_none=True)\n",
    "            prior_pred, post_pred, states = model.forward_chunk(xh, uh, mh, up, xf, mf)\n",
    "            prior_loss = masked_mse(prior_pred, xf, mf)\n",
    "            post_loss = masked_mse(post_pred, xf, mf)\n",
    "            slow = states[..., -cfg.slow_dim:]\n",
    "            slow_loss = ((slow[:, 1:] - slow[:, :-1]) ** 2).mean() if slow.shape[1] > 1 else torch.tensor(0.0, device=DEVICE)\n",
    "            loss = prior_loss + cfg.recon_weight * post_loss + cfg.slow_smooth_weight * slow_loss\n",
    "            loss.backward()\n",
    "            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "            optimizer.step()\n",
    "            train_values.append(float(loss.item()))\n",
    "            if CFG.run_stage == \"smoke\":\n",
    "                break\n",
    "\n",
    "        val_loss, persistence = evaluate_dt(model, val_loader, cfg)\n",
    "        train_loss = float(np.mean(train_values))\n",
    "        history.append({\n",
    "            \"epoch\": epoch,\n",
    "            \"train_loss\": train_loss,\n",
    "            \"val_loss\": val_loss,\n",
    "            \"persistence_val_loss\": persistence,\n",
    "        })\n",
    "\n",
    "        if val_loss < best_val - 1.0e-5:\n",
    "            best_val = val_loss\n",
    "            best_state = copy.deepcopy(model.state_dict())\n",
    "            best_epoch = epoch\n",
    "            wait = 0\n",
    "        else:\n",
    "            wait += 1\n",
    "        epoch_bar.set_postfix(val=f\"{val_loss:.4f}\", best=f\"{best_val:.4f}\")\n",
    "        if wait >= cfg.patience_dt:\n",
    "            break\n",
    "\n",
    "    epoch_bar.close()\n",
    "    model.load_state_dict(best_state)\n",
    "    model.eval()\n",
    "    final_val, persistence = evaluate_dt(model, val_loader, cfg)\n",
    "    return model, pd.DataFrame(history), final_val, persistence, best_epoch\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def extract_latent_trajectory(model, data, cfg, desc=\"latent extraction\"):\n",
    "    model.eval()\n",
    "    T = len(data[\"X\"])\n",
    "    Z = np.full((T, cfg.z_dim), np.nan, dtype=np.float32)\n",
    "    L = cfg.init_history\n",
    "    xh = torch.from_numpy(data[\"X\"][:L][None]).to(DEVICE)\n",
    "    uh = torch.from_numpy(data[\"U\"][:L][None]).to(DEVICE)\n",
    "    mh = torch.from_numpy(data[\"mask\"][:L][None]).to(DEVICE)\n",
    "    z = model.initialize(xh, uh, mh)\n",
    "    Z[L - 1] = z[0].cpu().numpy()\n",
    "\n",
    "    iterator = progress(\n",
    "        range(L, T),\n",
    "        desc=desc,\n",
    "        total=T - L,\n",
    "        leave=False,\n",
    "        unit=\"step\",\n",
    "    )\n",
    "    for t in iterator:\n",
    "        u_prev = torch.from_numpy(data[\"U\"][t:t + 1]).to(DEVICE)\n",
    "        x_t = torch.from_numpy(data[\"X\"][t:t + 1]).to(DEVICE)\n",
    "        m_t = torch.from_numpy(data[\"mask\"][t:t + 1]).to(DEVICE)\n",
    "        z, _, _ = model.step(z, u_prev, x_t, m_t)\n",
    "        Z[t] = z[0].cpu().numpy()\n",
    "    iterator.close()\n",
    "    return Z\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def reencode_at(model, data, cfg, t):\n",
    "    L = cfg.init_history\n",
    "    if t - L + 1 < 0:\n",
    "        raise ValueError(\"re-encoding window is outside the data range\")\n",
    "    sl = slice(t - L + 1, t + 1)\n",
    "    z = model.initialize(\n",
    "        torch.from_numpy(data[\"X\"][sl][None]).to(DEVICE),\n",
    "        torch.from_numpy(data[\"U\"][sl][None]).to(DEVICE),\n",
    "        torch.from_numpy(data[\"mask\"][sl][None]).to(DEVICE),\n",
    "    )\n",
    "    return z\n"
   ]
