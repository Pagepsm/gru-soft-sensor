    "def fit_activity_probes(Z, data, cfg):\n",
    "    valid = np.where(np.isfinite(Z).all(axis=1))[0]\n",
    "    train_idx = valid[valid < data[\"train_end\"]]\n",
    "    test_idx = valid[valid >= data[\"val_end\"]]\n",
    "    stride = 4 if CFG.run_stage != \"smoke\" else 12\n",
    "    train_idx = train_idx[::stride]\n",
    "    test_idx = test_idx[::stride]\n",
    "\n",
    "    xu = np.concatenate([data[\"X\"], data[\"U\"], data[\"mask\"]], axis=1)\n",
    "    y = data[\"activity_true\"]\n",
    "\n",
    "    sensor_probe = Ridge(alpha=1.0, solver=\"lsqr\").fit(xu[train_idx], y[train_idx])\n",
    "    latent_probe = Ridge(alpha=1.0, solver=\"lsqr\").fit(Z[train_idx], y[train_idx])\n",
    "    slow_probe = Ridge(alpha=1.0, solver=\"lsqr\").fit(Z[train_idx, -cfg.slow_dim:], y[train_idx])\n",
    "\n",
    "    return {\n",
    "        \"sensor_r2_test\": float(r2_score(y[test_idx], sensor_probe.predict(xu[test_idx]))),\n",
    "        \"latent_r2_test\": float(r2_score(y[test_idx], latent_probe.predict(Z[test_idx]))),\n",
    "        \"slow_latent_r2_test\": float(r2_score(y[test_idx], slow_probe.predict(Z[test_idx, -cfg.slow_dim:]))),\n",
    "    }\n",
    "\n",
    "\n",
    "def replay_batch(model, z_start, u_prev_seq, x_seq, m_seq):\n",
    "    z = z_start\n",
    "    for k in range(x_seq.shape[1]):\n",
    "        z, _, _ = model.step(z, u_prev_seq[:, k], x_seq[:, k], m_seq[:, k])\n",
    "    return z\n",
    "\n",
    "\n",
    "def propagate_single(model, data, z_start, start_t, target_times):\n",
    "    target_times = sorted(set(int(t) for t in target_times if int(t) >= int(start_t)))\n",
    "    if not target_times:\n",
    "        return {}, z_start\n",
    "    z = z_start\n",
    "    out = {int(start_t): z}\n",
    "    max_t = max(target_times)\n",
    "    for t in range(int(start_t) + 1, max_t + 1):\n",
    "        z, _, _ = model.step(\n",
    "            z,\n",
    "            torch.from_numpy(data[\"U\"][t:t + 1]).to(DEVICE),\n",
    "            torch.from_numpy(data[\"X\"][t:t + 1]).to(DEVICE),\n",
    "            torch.from_numpy(data[\"mask\"][t:t + 1]).to(DEVICE),\n",
    "        )\n",
    "        if t in target_times:\n",
    "            out[t] = z\n",
    "    return out, z\n",
    "\n",
    "\n",
    "def jacobian_correction(head, z_tau, residual_scaled, cfg):\n",
    "    z_var = z_tau.detach().clone().requires_grad_(True)\n",
    "    pred = head(z_var).sum()\n",
    "    grad = torch.autograd.grad(pred, z_var)[0]\n",
    "    g = grad[:, -cfg.slow_dim:]\n",
    "    denom = (g * g).sum(dim=1, keepdim=True) + 1.0e-3\n",
    "    delta_slow = g / denom * residual_scaled.reshape(-1, 1)\n",
    "    norm = torch.linalg.vector_norm(delta_slow, dim=1, keepdim=True).clamp_min(1.0e-8)\n",
    "    delta_slow = delta_slow * torch.clamp(cfg.correction_cap / norm, max=1.0)\n",
    "    delta = torch.zeros_like(z_tau)\n",
    "    delta[:, -cfg.slow_dim:] = delta_slow\n",
    "    return delta.detach()\n",
    "\n",
    "\n",
    "def online_update_head(head, z_tau, y_scaled, cfg):\n",
    "    local = copy.deepcopy(head).to(DEVICE)\n",
    "    for parameter in local.parameters():\n",
    "        parameter.requires_grad_(True)\n",
    "    local.train()\n",
    "    optimizer = torch.optim.SGD(local.parameters(), lr=cfg.online_head_lr)\n",
    "    target = torch.as_tensor([y_scaled], dtype=torch.float32, device=DEVICE)\n",
    "    for _ in range(cfg.online_head_steps):\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "        loss = nn.functional.smooth_l1_loss(local(z_tau), target)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "    local.eval()\n",
    "    return local\n",
    "\n",
    "\n",
    "def oracle_correction(model, head, data, z_tau, tau, arrival, cfg):\n",
    "    max_h = max(cfg.dense_horizons)\n",
    "    end = min(len(data[\"X\"]) - 1, arrival + max_h)\n",
    "    if end <= arrival:\n",
    "        return torch.zeros_like(z_tau)\n",
    "\n",
    "    raw = torch.zeros((1, cfg.slow_dim), device=DEVICE, requires_grad=True)\n",
    "    optimizer = torch.optim.Adam([raw], lr=cfg.oracle_lr)\n",
    "    target_times = list(range(arrival + 1, end + 1))\n",
    "    target_scaled = torch.from_numpy(\n",
    "        ((data[\"q_true\"][target_times] - float(data[\"q_mean\"])) / float(data[\"q_std\"])).astype(np.float32)\n",
    "    ).to(DEVICE)\n",
    "\n",
    "    for _ in range(cfg.oracle_steps):\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "        delta_slow = cfg.correction_cap * torch.tanh(raw)\n",
    "        delta = torch.zeros_like(z_tau)\n",
    "        delta[:, -cfg.slow_dim:] = delta_slow\n",
    "        z = z_tau + delta\n",
    "        preds = []\n",
    "        for t in range(tau + 1, end + 1):\n",
    "            z, _, _ = model.step(\n",
    "                z,\n",
    "                torch.from_numpy(data[\"U\"][t:t + 1]).to(DEVICE),\n",
    "                torch.from_numpy(data[\"X\"][t:t + 1]).to(DEVICE),\n",
    "                torch.from_numpy(data[\"mask\"][t:t + 1]).to(DEVICE),\n",
    "            )\n",
    "            if t > arrival:\n",
    "                preds.append(head(z))\n",
    "        pred = torch.cat(preds, dim=0)\n",
    "        loss = nn.functional.mse_loss(pred, target_scaled)\n",
    "        loss = loss + cfg.oracle_regularization * (delta_slow ** 2).mean()\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "    delta = torch.zeros_like(z_tau)\n",
    "    delta[:, -cfg.slow_dim:] = cfg.correction_cap * torch.tanh(raw.detach())\n",
    "    return delta\n"
   ]
