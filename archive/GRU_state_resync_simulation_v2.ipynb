    "class QualityHead(nn.Module):\n",
    "    def __init__(self, z_dim, hidden_dim):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
    "            nn.LayerNorm(z_dim),\n",
    "            nn.Linear(z_dim, hidden_dim),\n",
    "            nn.GELU(),\n",
    "            nn.Linear(hidden_dim, 1),\n",
    "        )\n",
    "\n",
    "    def forward(self, z):\n",
    "        return self.net(z).squeeze(-1)\n",
    "\n",
    "\n",
    "class QualityPointDataset(Dataset):\n",
    "    def __init__(self, Z, data, mask):\n",
    "        indices = np.where(mask)[0]\n",
    "        times = data[\"feature_times\"][indices]\n",
    "        finite = np.isfinite(Z[times]).all(axis=1)\n",
    "        self.indices = indices[finite]\n",
    "        self.times = times[finite]\n",
    "        self.Z = torch.from_numpy(Z.astype(np.float32))\n",
    "        self.y = torch.from_numpy(data[\"q_obs_scaled\"].astype(np.float32))\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.times)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        return self.Z[int(self.times[idx])], self.y[int(self.indices[idx])]\n",
    "\n",
    "\n",
    "def train_quality_head(Z, data, cfg, seed):\n",
    "    train_ds = QualityPointDataset(Z, data, data[\"q_train_mask\"])\n",
    "    val_ds = QualityPointDataset(Z, data, data[\"q_val_mask\"])\n",
    "    if len(train_ds) == 0 or len(val_ds) == 0:\n",
    "        raise ValueError(\"empty quality dataset\")\n",
    "\n",
    "    set_seed(seed + 100_000)\n",
    "    model = QualityHead(cfg.z_dim, cfg.quality_hidden_dim).to(DEVICE)\n",
    "    generator = torch.Generator().manual_seed(seed + 100_000)\n",
    "    train_loader = DataLoader(\n",
    "        train_ds,\n",
    "        batch_size=cfg.quality_batch_size,\n",
    "        shuffle=True,\n",
    "        generator=generator,\n",
    "    )\n",
    "    val_loader = DataLoader(val_ds, batch_size=cfg.quality_batch_size)\n",
    "    optimizer = torch.optim.AdamW(model.parameters(), lr=cfg.lr_quality, weight_decay=cfg.weight_decay)\n",
    "    loss_fn = nn.SmoothL1Loss()\n",
    "\n",
    "    best_val = float(\"inf\")\n",
    "    best_state = copy.deepcopy(model.state_dict())\n",
    "    best_epoch = 0\n",
    "    wait = 0\n",
    "    history = []\n",
    "    epoch_bar = progress(\n",
    "        range(1, cfg.epochs_quality + 1),\n",
    "        desc=f\"quality | seed={seed}\",\n",
    "        total=cfg.epochs_quality,\n",
    "        leave=False,\n",
    "        unit=\"epoch\",\n",
    "    )\n",
    "    for epoch in epoch_bar:\n",
    "        model.train()\n",
    "        train_values = []\n",
    "        for z, y in train_loader:\n",
    "            z, y = z.to(DEVICE), y.to(DEVICE)\n",
    "            optimizer.zero_grad(set_to_none=True)\n",
    "            loss = loss_fn(model(z), y)\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "            train_values.append(float(loss.item()))\n",
    "            if CFG.run_stage == \"smoke\":\n",
    "                break\n",
    "\n",
    "        model.eval()\n",
    "        val_values = []\n",
    "        with torch.no_grad():\n",
    "            for z, y in val_loader:\n",
    "                val_values.append(float(loss_fn(model(z.to(DEVICE)), y.to(DEVICE)).item()))\n",
    "                if CFG.run_stage == \"smoke\":\n",
    "                    break\n",
    "        val = float(np.mean(val_values))\n",
    "        history.append({\"epoch\": epoch, \"train_loss\": float(np.mean(train_values)), \"val_loss\": val})\n",
    "        if val < best_val - 1.0e-5:\n",
    "            best_val = val\n",
    "            best_state = copy.deepcopy(model.state_dict())\n",
    "            best_epoch = epoch\n",
    "            wait = 0\n",
    "        else:\n",
    "            wait += 1\n",
    "        epoch_bar.set_postfix(val=f\"{val:.4f}\", best=f\"{best_val:.4f}\")\n",
    "        if wait >= cfg.patience_quality:\n",
    "            break\n",
    "    epoch_bar.close()\n",
    "    model.load_state_dict(best_state)\n",
    "    model.eval()\n",
    "    return model, pd.DataFrame(history), best_val, best_epoch\n",
    "\n",
    "\n",
    "def predict_quality_scaled_tensor(head, z):\n",
    "    return head(z)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def predict_quality_np(head, z, data):\n",
    "    if not torch.is_tensor(z):\n",
    "        z = torch.as_tensor(z, dtype=torch.float32, device=DEVICE)\n",
    "    pred_scaled = head(z).cpu().numpy()\n",
    "    return unscale_quality(pred_scaled, data).astype(np.float32)\n"
